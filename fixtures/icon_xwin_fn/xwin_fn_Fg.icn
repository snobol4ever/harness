# xwin_fn_Fg
# The function ladder of the Icon window facility (skill icon reference.md section 9; the cto 09:2x CST 2026-11-16, officer_07): one small witness a window function, this one Fg alone, its defaults, its argument checks with the oracle's error numbers (each trapped by &error in main, never inside a co-expression), and a drawing read back with Pixel as letters. Its whole answer is its standard output; its window is a hidden canvas, so its screen line reads none.
global syms, nsyms

procedure sym(c)
   /syms := table();
   /nsyms := 0;
   if /syms[c] then {
      nsyms +:= 1;
      syms[c] := char(96 + nsyms);
      write("colour ", syms[c], " = ", c);
   };
   return syms[c];
end

procedure show(tag, w, x, y, wd, ht)
   local pix, s, i;
   pix := [];
   every put(pix, Pixel(w, x, y, wd, ht));
   write(tag, ": ", *pix, " pixels from ", x, ",", y, " size ", wd, "x", ht);
   s := "";
   every i := 1 to *pix do {
      s ||:= sym(pix[i]);
      if i % wd = 0 then {
         write("   ", s);
         s := "";
      };
   };
   if *s > 0 then write("   ", s);
   return;
end

procedure win(name)
   return open("xwin_fn " || name, "g", "size=40,30", "font=fixed", "fg=black", "bg=white", "canvas=hidden") | stop("no window");
end

procedure main()
   local w, w2, w3, e, a, v, r, f, s, t, c, i, k, n, p, pc, L, names;
   w := win("Fg");
   &error := 1;
   if v := Fg(w) then write("Fg default", ": ", image(v))
   else if &error = 0 then write("Fg default", ": error ", &errornumber)
   else write("Fg default", ": failed");
   &error := 0;
   &error := 1;
   if v := Fg(w, "red") then write("Fg red", ": ", image(v))
   else if &error = 0 then write("Fg red", ": error ", &errornumber)
   else write("Fg red", ": failed");
   &error := 0;
   DrawPoint(w, 1, 1);
   &error := 1;
   if v := Fg(w, "#00ff00") then write("Fg #00ff00", ": ", image(v))
   else if &error = 0 then write("Fg #00ff00", ": error ", &errornumber)
   else write("Fg #00ff00", ": failed");
   &error := 0;
   DrawPoint(w, 2, 1);
   &error := 1;
   if v := Fg(w, "0,0,65535") then write("Fg 0,0,65535", ": ", image(v))
   else if &error = 0 then write("Fg 0,0,65535", ": error ", &errornumber)
   else write("Fg 0,0,65535", ": failed");
   &error := 0;
   DrawPoint(w, 3, 1);
   &error := 1;
   if v := Fg(w, "dark grey") then write("Fg dark grey", ": ", image(v))
   else if &error = 0 then write("Fg dark grey", ": error ", &errornumber)
   else write("Fg dark grey", ": failed");
   &error := 0;
   DrawPoint(w, 4, 1);
   show("Fg", w, 0, 0, 6, 3);
   &error := 1;
   if v := Fg(w, "nosuchcolour") then write("Fg bad", ": ", image(v))
   else if &error = 0 then write("Fg bad", ": error ", &errornumber)
   else write("Fg bad", ": failed");
   &error := 0;
   &error := 1;
   if v := Fg(w, 3) then write("Fg integer", ": ", image(v))
   else if &error = 0 then write("Fg integer", ": error ", &errornumber)
   else write("Fg integer", ": failed");
   &error := 0;
   &error := 1;
   if v := Fg(w) then write("Fg after", ": ", image(v))
   else if &error = 0 then write("Fg after", ": error ", &errornumber)
   else write("Fg after", ": failed");
   &error := 0;
   &error := 1;
   if v := Fg("red") then write("Fg no window", ": ", image(v))
   else if &error = 0 then write("Fg no window", ": error ", &errornumber)
   else write("Fg no window", ": failed");
   &error := 0;
end
