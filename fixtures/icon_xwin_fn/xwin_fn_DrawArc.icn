# xwin_fn_DrawArc
# The function ladder of the Icon window facility (skill icon reference.md section 9; the cto 09:2x CST 2026-11-16, officer_07): one small witness a window function, this one DrawArc alone, its defaults, its argument checks with the oracle's error numbers (each trapped by &error in main, never inside a co-expression), and a drawing read back with Pixel as letters. Its whole answer is its standard output; its window is a hidden canvas, so its screen line reads none.
global syms, nsyms

procedure sym(c)
   /syms := table();
   /nsyms := 0;
   if /syms[c] then {
      nsyms +:= 1;
      syms[c] := char(96 + nsyms);
      write("colour ", syms[c], " = ", c);
   };
   return syms[c];
end

procedure show(tag, w, x, y, wd, ht)
   local pix, s, i;
   pix := [];
   every put(pix, Pixel(w, x, y, wd, ht));
   write(tag, ": ", *pix, " pixels from ", x, ",", y, " size ", wd, "x", ht);
   s := "";
   every i := 1 to *pix do {
      s ||:= sym(pix[i]);
      if i % wd = 0 then {
         write("   ", s);
         s := "";
      };
   };
   if *s > 0 then write("   ", s);
   return;
end

procedure win(name)
   return open("xwin_fn " || name, "g", "size=40,30", "font=fixed", "fg=black", "bg=white", "canvas=hidden") | stop("no window");
end

procedure main()
   local w, w2, w3, e, a, v, r, f, s, t, c, i, k, n, p, pc, L, names;
   w := win("DrawArc");
   &error := 1;
   if v := DrawArc(w, 1, 1, 12, 8) then write("DrawArc", ": ", image(v))
   else if &error = 0 then write("DrawArc", ": error ", &errornumber)
   else write("DrawArc", ": failed");
   &error := 0;
   show("DrawArc", w, 0, 0, 14, 10);
   &error := 1;
   if v := DrawArc(w, 16, 1, 12, 12, 0, &pi / 2) then write("DrawArc quarter", ": ", image(v))
   else if &error = 0 then write("DrawArc quarter", ": error ", &errornumber)
   else write("DrawArc quarter", ": failed");
   &error := 0;
   show("quarter", w, 15, 0, 14, 14);
   &error := 1;
   if v := DrawArc(w, 1, 1, 1) then write("DrawArc three", ": ", image(v))
   else if &error = 0 then write("DrawArc three", ": error ", &errornumber)
   else write("DrawArc three", ": failed");
   &error := 0;
   &error := 1;
   if v := DrawArc(w, "a", 1, 2, 3) then write("DrawArc a string", ": ", image(v))
   else if &error = 0 then write("DrawArc a string", ": error ", &errornumber)
   else write("DrawArc a string", ": failed");
   &error := 0;
   &error := 1;
   if v := DrawArc(1, 1, 5, 5) then write("DrawArc no window", ": ", image(v))
   else if &error = 0 then write("DrawArc no window", ": error ", &errornumber)
   else write("DrawArc no window", ": failed");
   &error := 0;
end
