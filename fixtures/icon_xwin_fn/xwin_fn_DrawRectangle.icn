# xwin_fn_DrawRectangle
# The function ladder of the Icon window facility (skill icon reference.md section 9; the cto 09:2x CST 2026-11-16, officer_07): one small witness a window function, this one DrawRectangle alone, its defaults, its argument checks with the oracle's error numbers (each trapped by &error in main, never inside a co-expression), and a drawing read back with Pixel as letters. Its whole answer is its standard output; its window is a hidden canvas, so its screen line reads none.
global syms, nsyms

procedure sym(c)
   /syms := table();
   /nsyms := 0;
   if /syms[c] then {
      nsyms +:= 1;
      syms[c] := char(96 + nsyms);
      write("colour ", syms[c], " = ", c);
   };
   return syms[c];
end

procedure show(tag, w, x, y, wd, ht)
   local pix, s, i;
   pix := [];
   every put(pix, Pixel(w, x, y, wd, ht));
   write(tag, ": ", *pix, " pixels from ", x, ",", y, " size ", wd, "x", ht);
   s := "";
   every i := 1 to *pix do {
      s ||:= sym(pix[i]);
      if i % wd = 0 then {
         write("   ", s);
         s := "";
      };
   };
   if *s > 0 then write("   ", s);
   return;
end

procedure win(name)
   return open("xwin_fn " || name, "g", "size=40,30", "font=fixed", "fg=black", "bg=white", "canvas=hidden") | stop("no window");
end

procedure main()
   local w, w2, w3, e, a, v, r, f, s, t, c, i, k, n, p, pc, L, names;
   w := win("DrawRectangle");
   &error := 1;
   if v := DrawRectangle(w, 1, 1, 6, 4) then write("DrawRectangle", ": ", image(v))
   else if &error = 0 then write("DrawRectangle", ": error ", &errornumber)
   else write("DrawRectangle", ": failed");
   &error := 0;
   show("DrawRectangle", w, 0, 0, 9, 7);
   &error := 1;
   if v := DrawRectangle(w, 20, 10, -4, -3) then write("DrawRectangle negative", ": ", image(v))
   else if &error = 0 then write("DrawRectangle negative", ": error ", &errornumber)
   else write("DrawRectangle negative", ": failed");
   &error := 0;
   show("negative", w, 15, 6, 7, 6);
   &error := 1;
   if v := DrawRectangle(w, 1, 1, 1) then write("DrawRectangle three", ": ", image(v))
   else if &error = 0 then write("DrawRectangle three", ": error ", &errornumber)
   else write("DrawRectangle three", ": failed");
   &error := 0;
   &error := 1;
   if v := DrawRectangle(w, "a") then write("DrawRectangle a string", ": ", image(v))
   else if &error = 0 then write("DrawRectangle a string", ": error ", &errornumber)
   else write("DrawRectangle a string", ": failed");
   &error := 0;
   Fg(w, "red");
   &error := 1;
   if v := DrawRectangle(w) then write("DrawRectangle whole", ": ", image(v))
   else if &error = 0 then write("DrawRectangle whole", ": error ", &errornumber)
   else write("DrawRectangle whole", ": failed");
   &error := 0;
   show("whole", w, 36, 26, 4, 4);
end
