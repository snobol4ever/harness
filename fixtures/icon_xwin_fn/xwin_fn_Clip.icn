# xwin_fn_Clip
# The function ladder of the Icon window facility (skill icon reference.md section 9; the cto 09:2x CST 2026-11-16, officer_07): one small witness a window function, this one Clip alone, its defaults, its argument checks with the oracle's error numbers (each trapped by &error in main, never inside a co-expression), and a drawing read back with Pixel as letters. Its whole answer is its standard output; its window is a hidden canvas, so its screen line reads none.
global syms, nsyms

procedure sym(c)
   /syms := table();
   /nsyms := 0;
   if /syms[c] then {
      nsyms +:= 1;
      syms[c] := char(96 + nsyms);
      write("colour ", syms[c], " = ", c);
   };
   return syms[c];
end

procedure show(tag, w, x, y, wd, ht)
   local pix, s, i;
   pix := [];
   every put(pix, Pixel(w, x, y, wd, ht));
   write(tag, ": ", *pix, " pixels from ", x, ",", y, " size ", wd, "x", ht);
   s := "";
   every i := 1 to *pix do {
      s ||:= sym(pix[i]);
      if i % wd = 0 then {
         write("   ", s);
         s := "";
      };
   };
   if *s > 0 then write("   ", s);
   return;
end

procedure win(name)
   return open("xwin_fn " || name, "g", "size=40,30", "font=fixed", "fg=black", "bg=white", "canvas=hidden") | stop("no window");
end

procedure main()
   local w, w2, w3, e, a, v, r, f, s, t, c, i, k, n, p, pc, L, names;
   w := win("Clip");
   &error := 1;
   if v := Clip(w, 2, 2, 6, 4) then write("Clip", ": ", image(v))
   else if &error = 0 then write("Clip", ": error ", &errornumber)
   else write("Clip", ": failed");
   &error := 0;
   every writes(WAttrib(w, "clipx", "clipy", "clipw", "cliph"), " ");
   write();
   Fg(w, "red");
   FillRectangle(w);
   show("clipped", w, 0, 0, 10, 8);
   &error := 1;
   if v := Clip(w) then write("Clip reset", ": ", image(v))
   else if &error = 0 then write("Clip reset", ": error ", &errornumber)
   else write("Clip reset", ": failed");
   &error := 0;
   every writes(WAttrib(w, "clipx", "clipy", "clipw", "cliph"), " ");
   write();
   &error := 1;
   if v := Clip(w, 1, 1, 1) then write("Clip three", ": ", image(v))
   else if &error = 0 then write("Clip three", ": error ", &errornumber)
   else write("Clip three", ": failed");
   &error := 0;
   &error := 1;
   if v := Clip(w, "a") then write("Clip a string", ": ", image(v))
   else if &error = 0 then write("Clip a string", ": error ", &errornumber)
   else write("Clip a string", ": failed");
   &error := 0;
end
