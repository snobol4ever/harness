# xwin_fn_Alert
# The function ladder of the Icon window facility (skill icon reference.md section 9; the cto 09:2x CST 2026-11-16, officer_07): one small witness a window function, this one Alert alone, its defaults, its argument checks with the oracle's error numbers (each trapped by &error in main, never inside a co-expression), and a drawing read back with Pixel as letters. Its whole answer is its standard output; its window is a hidden canvas, so its screen line reads none.
global syms, nsyms

procedure sym(c)
   /syms := table();
   /nsyms := 0;
   if /syms[c] then {
      nsyms +:= 1;
      syms[c] := char(96 + nsyms);
      write("colour ", syms[c], " = ", c);
   };
   return syms[c];
end

procedure show(tag, w, x, y, wd, ht)
   local pix, s, i;
   pix := [];
   every put(pix, Pixel(w, x, y, wd, ht));
   write(tag, ": ", *pix, " pixels from ", x, ",", y, " size ", wd, "x", ht);
   s := "";
   every i := 1 to *pix do {
      s ||:= sym(pix[i]);
      if i % wd = 0 then {
         write("   ", s);
         s := "";
      };
   };
   if *s > 0 then write("   ", s);
   return;
end

procedure win(name)
   return open("xwin_fn " || name, "g", "size=40,30", "font=fixed", "fg=black", "bg=white", "canvas=hidden") | stop("no window");
end

procedure main()
   local w, w2, w3, e, a, v, r, f, s, t, c, i, k, n, p, pc, L, names;
   w := win("Alert");
   &error := 1;
   if v := image(Alert(w)) then write("Alert", ": ", image(v))
   else if &error = 0 then write("Alert", ": error ", &errornumber)
   else write("Alert", ": failed");
   &error := 0;
   &error := 1;
   if v := image(Alert(w, 50)) then write("Alert 50", ": ", image(v))
   else if &error = 0 then write("Alert 50", ": error ", &errornumber)
   else write("Alert 50", ": failed");
   &error := 0;
   &error := 1;
   if v := image(Alert(w, -100)) then write("Alert -100", ": ", image(v))
   else if &error = 0 then write("Alert -100", ": error ", &errornumber)
   else write("Alert -100", ": failed");
   &error := 0;
   &error := 1;
   if v := Alert(w, "loud") then write("Alert a string volume", ": ", image(v))
   else if &error = 0 then write("Alert a string volume", ": error ", &errornumber)
   else write("Alert a string volume", ": failed");
   &error := 0;
   &error := 1;
   if v := Alert() then write("Alert no window", ": ", image(v))
   else if &error = 0 then write("Alert no window", ": error ", &errornumber)
   else write("Alert no window", ": failed");
   &error := 0;
end
