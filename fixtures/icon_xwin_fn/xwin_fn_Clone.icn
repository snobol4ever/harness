# xwin_fn_Clone
# The function ladder of the Icon window facility (skill icon reference.md section 9; the cto 09:2x CST 2026-11-16, officer_07): one small witness a window function, this one Clone alone, its defaults, its argument checks with the oracle's error numbers (each trapped by &error in main, never inside a co-expression), and a drawing read back with Pixel as letters. Its whole answer is its standard output; its window is a hidden canvas, so its screen line reads none.
global syms, nsyms

procedure sym(c)
   /syms := table();
   /nsyms := 0;
   if /syms[c] then {
      nsyms +:= 1;
      syms[c] := char(96 + nsyms);
      write("colour ", syms[c], " = ", c);
   };
   return syms[c];
end

procedure show(tag, w, x, y, wd, ht)
   local pix, s, i;
   pix := [];
   every put(pix, Pixel(w, x, y, wd, ht));
   write(tag, ": ", *pix, " pixels from ", x, ",", y, " size ", wd, "x", ht);
   s := "";
   every i := 1 to *pix do {
      s ||:= sym(pix[i]);
      if i % wd = 0 then {
         write("   ", s);
         s := "";
      };
   };
   if *s > 0 then write("   ", s);
   return;
end

procedure win(name)
   return open("xwin_fn " || name, "g", "size=40,30", "font=fixed", "fg=black", "bg=white", "canvas=hidden") | stop("no window");
end

procedure main()
   local w, w2, w3, e, a, v, r, f, s, t, c, i, k, n, p, pc, L, names;
   w := win("Clone");
   &error := 1;
   if v := image(w2 := Clone(w, "fg=red", "linewidth=3")) then write("Clone", ": ", image(v))
   else if &error = 0 then write("Clone", ": error ", &errornumber)
   else write("Clone", ": failed");
   &error := 0;
   &error := 1;
   if v := Fg(w) then write("Fg of w", ": ", image(v))
   else if &error = 0 then write("Fg of w", ": error ", &errornumber)
   else write("Fg of w", ": failed");
   &error := 0;
   &error := 1;
   if v := Fg(w2) then write("Fg of the clone", ": ", image(v))
   else if &error = 0 then write("Fg of the clone", ": error ", &errornumber)
   else write("Fg of the clone", ": failed");
   &error := 0;
   &error := 1;
   if v := WAttrib(w2, "linewidth") then write("linewidth of the clone", ": ", image(v))
   else if &error = 0 then write("linewidth of the clone", ": error ", &errornumber)
   else write("linewidth of the clone", ": failed");
   &error := 0;
   DrawLine(w2, 0, 4, 10, 4);
   show("drawn by the clone", w, 0, 2, 11, 5);
   &error := 1;
   if v := image(Clone(w)) then write("Clone plain", ": ", image(v))
   else if &error = 0 then write("Clone plain", ": error ", &errornumber)
   else write("Clone plain", ": failed");
   &error := 0;
   &error := 1;
   if v := Clone(w, "nosuchattr=1") then write("Clone bad attribute", ": ", image(v))
   else if &error = 0 then write("Clone bad attribute", ": error ", &errornumber)
   else write("Clone bad attribute", ": failed");
   &error := 0;
   &error := 1;
   if v := Clone(w, "fg=nosuchcolour") then write("Clone bad value", ": ", image(v))
   else if &error = 0 then write("Clone bad value", ": error ", &errornumber)
   else write("Clone bad value", ": failed");
   &error := 0;
   &error := 1;
   if v := Clone("x") then write("Clone a string", ": ", image(v))
   else if &error = 0 then write("Clone a string", ": error ", &errornumber)
   else write("Clone a string", ": failed");
   &error := 0;
end
