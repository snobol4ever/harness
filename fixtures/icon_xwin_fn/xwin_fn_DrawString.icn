# xwin_fn_DrawString
# The function ladder of the Icon window facility (skill icon reference.md section 9; the cto 09:2x CST 2026-11-16, officer_07): one small witness a window function, this one DrawString alone, its defaults, its argument checks with the oracle's error numbers (each trapped by &error in main, never inside a co-expression), and a drawing read back with Pixel as letters. Its whole answer is its standard output; its window is a hidden canvas, so its screen line reads none.
global syms, nsyms

procedure sym(c)
   /syms := table();
   /nsyms := 0;
   if /syms[c] then {
      nsyms +:= 1;
      syms[c] := char(96 + nsyms);
      write("colour ", syms[c], " = ", c);
   };
   return syms[c];
end

procedure show(tag, w, x, y, wd, ht)
   local pix, s, i;
   pix := [];
   every put(pix, Pixel(w, x, y, wd, ht));
   write(tag, ": ", *pix, " pixels from ", x, ",", y, " size ", wd, "x", ht);
   s := "";
   every i := 1 to *pix do {
      s ||:= sym(pix[i]);
      if i % wd = 0 then {
         write("   ", s);
         s := "";
      };
   };
   if *s > 0 then write("   ", s);
   return;
end

procedure win(name)
   return open("xwin_fn " || name, "g", "size=40,30", "font=fixed", "fg=black", "bg=white", "canvas=hidden") | stop("no window");
end

procedure main()
   local w, w2, w3, e, a, v, r, f, s, t, c, i, k, n, p, pc, L, names;
   w := win("DrawString");
   &error := 1;
   if v := DrawString(w, 2, 12, "Hi") then write("DrawString", ": ", image(v))
   else if &error = 0 then write("DrawString", ": error ", &errornumber)
   else write("DrawString", ": failed");
   &error := 0;
   show("DrawString", w, 0, 0, 16, 16);
   &error := 1;
   if v := DrawString(w, 2, 26, "a", 20, 26, "b") then write("DrawString two strings", ": ", image(v))
   else if &error = 0 then write("DrawString two strings", ": error ", &errornumber)
   else write("DrawString two strings", ": failed");
   &error := 0;
   &error := 1;
   if v := DrawString(w, 2, 26, 7) then write("DrawString integer", ": ", image(v))
   else if &error = 0 then write("DrawString integer", ": error ", &errornumber)
   else write("DrawString integer", ": failed");
   &error := 0;
   &error := 1;
   if v := DrawString(w, 1, 1) then write("DrawString no string", ": ", image(v))
   else if &error = 0 then write("DrawString no string", ": error ", &errornumber)
   else write("DrawString no string", ": failed");
   &error := 0;
   &error := 1;
   if v := DrawString(w, 1, 1, []) then write("DrawString a list", ": ", image(v))
   else if &error = 0 then write("DrawString a list", ": error ", &errornumber)
   else write("DrawString a list", ": failed");
   &error := 0;
   &error := 1;
   if v := DrawString(1, 1, "x") then write("DrawString no window", ": ", image(v))
   else if &error = 0 then write("DrawString no window", ": error ", &errornumber)
   else write("DrawString no window", ": failed");
   &error := 0;
end
