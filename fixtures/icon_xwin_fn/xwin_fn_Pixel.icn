# xwin_fn_Pixel
# The function ladder of the Icon window facility (skill icon reference.md section 9; the cto 09:2x CST 2026-11-16, officer_07): one small witness a window function, this one Pixel alone, its defaults, its argument checks with the oracle's error numbers (each trapped by &error in main, never inside a co-expression), and a drawing read back with Pixel as letters. Its whole answer is its standard output; its window is a hidden canvas, so its screen line reads none.
global syms, nsyms

procedure sym(c)
   /syms := table();
   /nsyms := 0;
   if /syms[c] then {
      nsyms +:= 1;
      syms[c] := char(96 + nsyms);
      write("colour ", syms[c], " = ", c);
   };
   return syms[c];
end

procedure show(tag, w, x, y, wd, ht)
   local pix, s, i;
   pix := [];
   every put(pix, Pixel(w, x, y, wd, ht));
   write(tag, ": ", *pix, " pixels from ", x, ",", y, " size ", wd, "x", ht);
   s := "";
   every i := 1 to *pix do {
      s ||:= sym(pix[i]);
      if i % wd = 0 then {
         write("   ", s);
         s := "";
      };
   };
   if *s > 0 then write("   ", s);
   return;
end

procedure win(name)
   return open("xwin_fn " || name, "g", "size=40,30", "font=fixed", "fg=black", "bg=white", "canvas=hidden") | stop("no window");
end

procedure main()
   local w, w2, w3, e, a, v, r, f, s, t, c, i, k, n, p, pc, L, names;
   w := win("Pixel");
   Fg(w, "red");
   DrawPoint(w, 1, 0);
   Fg(w, "blue");
   DrawPoint(w, 2, 1);
   &error := 1;
   if v := *[Pixel(w, 0, 0, 3, 2)] then write("Pixel generation", ": ", image(v))
   else if &error = 0 then write("Pixel generation", ": error ", &errornumber)
   else write("Pixel generation", ": failed");
   &error := 0;
   every writes(Pixel(w, 0, 0, 3, 2), " ");
   write();
   &error := 1;
   if v := Pixel(w, 1, 0, 1, 1) then write("Pixel one", ": ", image(v))
   else if &error = 0 then write("Pixel one", ": error ", &errornumber)
   else write("Pixel one", ": failed");
   &error := 0;
   &error := 1;
   if v := *[Pixel(w, 38, 28)] then write("Pixel default size", ": ", image(v))
   else if &error = 0 then write("Pixel default size", ": error ", &errornumber)
   else write("Pixel default size", ": failed");
   &error := 0;
   n := 0;
   every Pixel(w) do n +:= 1;
   write("Pixel whole window ", n);
   &error := 1;
   if v := *[Pixel(w, 100, 100, 2, 2)] then write("Pixel outside", ": ", image(v))
   else if &error = 0 then write("Pixel outside", ": error ", &errornumber)
   else write("Pixel outside", ": failed");
   &error := 0;
   &error := 1;
   if v := Pixel(w, "a") then write("Pixel a string", ": ", image(v))
   else if &error = 0 then write("Pixel a string", ": error ", &errornumber)
   else write("Pixel a string", ": failed");
   &error := 0;
   &error := 1;
   if v := *[Pixel()] then write("Pixel no window", ": ", image(v))
   else if &error = 0 then write("Pixel no window", ": error ", &errornumber)
   else write("Pixel no window", ": failed");
   &error := 0;
end
