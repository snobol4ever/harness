# xwin_fn_PaletteChars
# The function ladder of the Icon window facility (skill icon reference.md section 9; the cto 09:2x CST 2026-11-16, officer_07): one small witness a window function, this one PaletteChars alone, its defaults, its argument checks with the oracle's error numbers (each trapped by &error in main, never inside a co-expression), and a drawing read back with Pixel as letters. Its whole answer is its standard output; its window is a hidden canvas, so its screen line reads none.
global syms, nsyms

procedure sym(c)
   /syms := table();
   /nsyms := 0;
   if /syms[c] then {
      nsyms +:= 1;
      syms[c] := char(96 + nsyms);
      write("colour ", syms[c], " = ", c);
   };
   return syms[c];
end

procedure show(tag, w, x, y, wd, ht)
   local pix, s, i;
   pix := [];
   every put(pix, Pixel(w, x, y, wd, ht));
   write(tag, ": ", *pix, " pixels from ", x, ",", y, " size ", wd, "x", ht);
   s := "";
   every i := 1 to *pix do {
      s ||:= sym(pix[i]);
      if i % wd = 0 then {
         write("   ", s);
         s := "";
      };
   };
   if *s > 0 then write("   ", s);
   return;
end

procedure win(name)
   return open("xwin_fn " || name, "g", "size=40,30", "font=fixed", "fg=black", "bg=white", "canvas=hidden") | stop("no window");
end

procedure main()
   local w, w2, w3, e, a, v, r, f, s, t, c, i, k, n, p, pc, L, names;
   w := win("PaletteChars");
   every p := !["c1", "c2", "c3", "c4", "c5", "c6", "g2", "g16", "g64", "g256", "c7", "g1", "nosuch"] do
      &error := 1;
      if v := PaletteChars(w, p) then write("PaletteChars " || p, ": ", image(v))
      else if &error = 0 then write("PaletteChars " || p, ": error ", &errornumber)
      else write("PaletteChars " || p, ": failed");
      &error := 0;
   &error := 1;
   if v := PaletteChars(w) then write("PaletteChars default", ": ", image(v))
   else if &error = 0 then write("PaletteChars default", ": error ", &errornumber)
   else write("PaletteChars default", ": failed");
   &error := 0;
   &error := 1;
   if v := PaletteChars("c1") then write("PaletteChars no window", ": ", image(v))
   else if &error = 0 then write("PaletteChars no window", ": error ", &errornumber)
   else write("PaletteChars no window", ": failed");
   &error := 0;
end
