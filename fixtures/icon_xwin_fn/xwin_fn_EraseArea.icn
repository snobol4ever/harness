# xwin_fn_EraseArea
# The function ladder of the Icon window facility (skill icon reference.md section 9; the cto 09:2x CST 2026-11-16, officer_07): one small witness a window function, this one EraseArea alone, its defaults, its argument checks with the oracle's error numbers (each trapped by &error in main, never inside a co-expression), and a drawing read back with Pixel as letters. Its whole answer is its standard output; its window is a hidden canvas, so its screen line reads none.
global syms, nsyms

procedure sym(c)
   /syms := table();
   /nsyms := 0;
   if /syms[c] then {
      nsyms +:= 1;
      syms[c] := char(96 + nsyms);
      write("colour ", syms[c], " = ", c);
   };
   return syms[c];
end

procedure show(tag, w, x, y, wd, ht)
   local pix, s, i;
   pix := [];
   every put(pix, Pixel(w, x, y, wd, ht));
   write(tag, ": ", *pix, " pixels from ", x, ",", y, " size ", wd, "x", ht);
   s := "";
   every i := 1 to *pix do {
      s ||:= sym(pix[i]);
      if i % wd = 0 then {
         write("   ", s);
         s := "";
      };
   };
   if *s > 0 then write("   ", s);
   return;
end

procedure win(name)
   return open("xwin_fn " || name, "g", "size=40,30", "font=fixed", "fg=black", "bg=white", "canvas=hidden") | stop("no window");
end

procedure main()
   local w, w2, w3, e, a, v, r, f, s, t, c, i, k, n, p, pc, L, names;
   w := win("EraseArea");
   Fg(w, "red");
   FillRectangle(w);
   &error := 1;
   if v := EraseArea(w, 2, 2, 4, 3) then write("EraseArea", ": ", image(v))
   else if &error = 0 then write("EraseArea", ": error ", &errornumber)
   else write("EraseArea", ": failed");
   &error := 0;
   show("EraseArea", w, 0, 0, 8, 7);
   Bg(w, "blue");
   &error := 1;
   if v := EraseArea(w, 10, 10, 2, 2) then write("EraseArea in blue", ": ", image(v))
   else if &error = 0 then write("EraseArea in blue", ": error ", &errornumber)
   else write("EraseArea in blue", ": failed");
   &error := 0;
   show("blue", w, 9, 9, 4, 4);
   &error := 1;
   if v := EraseArea(w, 1, 1, 1) then write("EraseArea three", ": ", image(v))
   else if &error = 0 then write("EraseArea three", ": error ", &errornumber)
   else write("EraseArea three", ": failed");
   &error := 0;
   &error := 1;
   if v := EraseArea(w, "a") then write("EraseArea a string", ": ", image(v))
   else if &error = 0 then write("EraseArea a string", ": error ", &errornumber)
   else write("EraseArea a string", ": failed");
   &error := 0;
   &error := 1;
   if v := EraseArea(w) then write("EraseArea whole", ": ", image(v))
   else if &error = 0 then write("EraseArea whole", ": error ", &errornumber)
   else write("EraseArea whole", ": failed");
   &error := 0;
   show("whole", w, 36, 26, 4, 4);
end
