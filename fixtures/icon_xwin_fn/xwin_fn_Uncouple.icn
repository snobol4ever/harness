# xwin_fn_Uncouple
# The function ladder of the Icon window facility (skill icon reference.md section 9; the cto 09:2x CST 2026-11-16, officer_07): one small witness a window function, this one Uncouple alone, its defaults, its argument checks with the oracle's error numbers (each trapped by &error in main, never inside a co-expression), and a drawing read back with Pixel as letters. Its whole answer is its standard output; its window is a hidden canvas, so its screen line reads none.
global syms, nsyms

procedure sym(c)
   /syms := table();
   /nsyms := 0;
   if /syms[c] then {
      nsyms +:= 1;
      syms[c] := char(96 + nsyms);
      write("colour ", syms[c], " = ", c);
   };
   return syms[c];
end

procedure show(tag, w, x, y, wd, ht)
   local pix, s, i;
   pix := [];
   every put(pix, Pixel(w, x, y, wd, ht));
   write(tag, ": ", *pix, " pixels from ", x, ",", y, " size ", wd, "x", ht);
   s := "";
   every i := 1 to *pix do {
      s ||:= sym(pix[i]);
      if i % wd = 0 then {
         write("   ", s);
         s := "";
      };
   };
   if *s > 0 then write("   ", s);
   return;
end

procedure win(name)
   return open("xwin_fn " || name, "g", "size=40,30", "font=fixed", "fg=black", "bg=white", "canvas=hidden") | stop("no window");
end

procedure main()
   local w, w2, w3, e, a, v, r, f, s, t, c, i, k, n, p, pc, L, names;
   w := win("Uncouple");
   w2 := Clone(w);
   &error := 1;
   if v := type(Uncouple(w2)) then write("Uncouple", ": ", image(v))
   else if &error = 0 then write("Uncouple", ": error ", &errornumber)
   else write("Uncouple", ": failed");
   &error := 0;
   &error := 1;
   if v := image(Uncouple(w2)) then write("Uncouple twice", ": ", image(v))
   else if &error = 0 then write("Uncouple twice", ": error ", &errornumber)
   else write("Uncouple twice", ": failed");
   &error := 0;
   &error := 1;
   if v := Uncouple("x") then write("Uncouple a string", ": ", image(v))
   else if &error = 0 then write("Uncouple a string", ": error ", &errornumber)
   else write("Uncouple a string", ": failed");
   &error := 0;
   &error := 1;
   if v := Uncouple() then write("Uncouple none", ": ", image(v))
   else if &error = 0 then write("Uncouple none", ": error ", &errornumber)
   else write("Uncouple none", ": failed");
   &error := 0;
   &error := 1;
   if v := DrawPoint(w, 1, 1) then write("w still draws", ": ", image(v))
   else if &error = 0 then write("w still draws", ": error ", &errornumber)
   else write("w still draws", ": failed");
   &error := 0;
   show("w", w, 0, 0, 3, 3);
end
