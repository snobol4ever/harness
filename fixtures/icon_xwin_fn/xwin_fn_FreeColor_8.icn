# xwin_fn_FreeColor_8
# At depth 8 (its NAME.depth): the success arms of FreeColor that a PseudoColor display allows, beside the 24-bit witness xwin_fn_FreeColor (the cto 10:1x CST).
# The function ladder of the Icon window facility (skill icon reference.md section 9; the cto 09:2x CST 2026-11-16, officer_07): one small witness a window function, this one FreeColor_8 alone, its defaults, its argument checks with the oracle's error numbers (each trapped by &error in main, never inside a co-expression), and a drawing read back with Pixel as letters. Its whole answer is its standard output; its window is a hidden canvas, so its screen line reads none.
global syms, nsyms

procedure sym(c)
   /syms := table();
   /nsyms := 0;
   if /syms[c] then {
      nsyms +:= 1;
      syms[c] := char(96 + nsyms);
      write("colour ", syms[c], " = ", c);
   };
   return syms[c];
end

procedure show(tag, w, x, y, wd, ht)
   local pix, s, i;
   pix := [];
   every put(pix, Pixel(w, x, y, wd, ht));
   write(tag, ": ", *pix, " pixels from ", x, ",", y, " size ", wd, "x", ht);
   s := "";
   every i := 1 to *pix do {
      s ||:= sym(pix[i]);
      if i % wd = 0 then {
         write("   ", s);
         s := "";
      };
   };
   if *s > 0 then write("   ", s);
   return;
end

procedure win(name)
   return open("xwin_fn " || name, "g", "size=40,30", "font=fixed", "fg=black", "bg=white", "canvas=hidden") | stop("no window");
end

procedure main()
   local w, w2, w3, e, a, v, r, f, s, t, c, i, k, n, p, pc, L, names;
   w := win("FreeColor_8");
   &error := 1;
   if v := i := NewColor(w, "red") then write("NewColor red", ": ", image(v))
   else if &error = 0 then write("NewColor red", ": error ", &errornumber)
   else write("NewColor red", ": failed");
   &error := 0;
   &error := 1;
   if v := j := NewColor(w, "blue") then write("NewColor blue", ": ", image(v))
   else if &error = 0 then write("NewColor blue", ": error ", &errornumber)
   else write("NewColor blue", ": failed");
   &error := 0;
   &error := 1;
   if v := image(FreeColor(w, i)) then write("FreeColor the red one", ": ", image(v))
   else if &error = 0 then write("FreeColor the red one", ": error ", &errornumber)
   else write("FreeColor the red one", ": failed");
   &error := 0;
   &error := 1;
   if v := Color(w, i) then write("Color after the free", ": ", image(v))
   else if &error = 0 then write("Color after the free", ": error ", &errornumber)
   else write("Color after the free", ": failed");
   &error := 0;
   &error := 1;
   if v := image(FreeColor(w, i)) then write("FreeColor the red one again", ": ", image(v))
   else if &error = 0 then write("FreeColor the red one again", ": error ", &errornumber)
   else write("FreeColor the red one again", ": failed");
   &error := 0;
   &error := 1;
   if v := image(FreeColor(w, "green")) then write("FreeColor a shared colour", ": ", image(v))
   else if &error = 0 then write("FreeColor a shared colour", ": error ", &errornumber)
   else write("FreeColor a shared colour", ": failed");
   &error := 0;
   &error := 1;
   if v := image(FreeColor(w, j, "yellow")) then write("FreeColor two", ": ", image(v))
   else if &error = 0 then write("FreeColor two", ": error ", &errornumber)
   else write("FreeColor two", ": failed");
   &error := 0;
   &error := 1;
   if v := FreeColor(w, "nosuchcolour") then write("FreeColor bad", ": ", image(v))
   else if &error = 0 then write("FreeColor bad", ": error ", &errornumber)
   else write("FreeColor bad", ": failed");
   &error := 0;
   &error := 1;
   if v := image(FreeColor(w)) then write("FreeColor none", ": ", image(v))
   else if &error = 0 then write("FreeColor none", ": error ", &errornumber)
   else write("FreeColor none", ": failed");
   &error := 0;
end
