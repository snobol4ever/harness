# xwin_fn_FillCircle
# The function ladder of the Icon window facility (skill icon reference.md section 9; the cto 09:2x CST 2026-11-16, officer_07): one small witness a window function, this one FillCircle alone, its defaults, its argument checks with the oracle's error numbers (each trapped by &error in main, never inside a co-expression), and a drawing read back with Pixel as letters. Its whole answer is its standard output; its window is a hidden canvas, so its screen line reads none.
global syms, nsyms

procedure sym(c)
   /syms := table();
   /nsyms := 0;
   if /syms[c] then {
      nsyms +:= 1;
      syms[c] := char(96 + nsyms);
      write("colour ", syms[c], " = ", c);
   };
   return syms[c];
end

procedure show(tag, w, x, y, wd, ht)
   local pix, s, i;
   pix := [];
   every put(pix, Pixel(w, x, y, wd, ht));
   write(tag, ": ", *pix, " pixels from ", x, ",", y, " size ", wd, "x", ht);
   s := "";
   every i := 1 to *pix do {
      s ||:= sym(pix[i]);
      if i % wd = 0 then {
         write("   ", s);
         s := "";
      };
   };
   if *s > 0 then write("   ", s);
   return;
end

procedure win(name)
   return open("xwin_fn " || name, "g", "size=40,30", "font=fixed", "fg=black", "bg=white", "canvas=hidden") | stop("no window");
end

procedure main()
   local w, w2, w3, e, a, v, r, f, s, t, c, i, k, n, p, pc, L, names;
   w := win("FillCircle");
   &error := 1;
   if v := FillCircle(w, 8, 8, 6) then write("FillCircle", ": ", image(v))
   else if &error = 0 then write("FillCircle", ": error ", &errornumber)
   else write("FillCircle", ": failed");
   &error := 0;
   show("FillCircle", w, 1, 1, 15, 15);
   &error := 1;
   if v := FillCircle(w, 28, 12, 8, 0, &pi) then write("FillCircle arc", ": ", image(v))
   else if &error = 0 then write("FillCircle arc", ": error ", &errornumber)
   else write("FillCircle arc", ": failed");
   &error := 0;
   show("arc", w, 19, 3, 19, 19);
   &error := 1;
   if v := FillCircle(w, 1, 1) then write("FillCircle two", ": ", image(v))
   else if &error = 0 then write("FillCircle two", ": error ", &errornumber)
   else write("FillCircle two", ": failed");
   &error := 0;
   &error := 1;
   if v := FillCircle(w, "a", 1, 2) then write("FillCircle a string", ": ", image(v))
   else if &error = 0 then write("FillCircle a string", ": error ", &errornumber)
   else write("FillCircle a string", ": failed");
   &error := 0;
end
