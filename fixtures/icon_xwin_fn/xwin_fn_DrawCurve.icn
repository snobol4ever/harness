# xwin_fn_DrawCurve
# The function ladder of the Icon window facility (skill icon reference.md section 9; the cto 09:2x CST 2026-11-16, officer_07): one small witness a window function, this one DrawCurve alone, its defaults, its argument checks with the oracle's error numbers (each trapped by &error in main, never inside a co-expression), and a drawing read back with Pixel as letters. Its whole answer is its standard output; its window is a hidden canvas, so its screen line reads none.
global syms, nsyms

procedure sym(c)
   /syms := table();
   /nsyms := 0;
   if /syms[c] then {
      nsyms +:= 1;
      syms[c] := char(96 + nsyms);
      write("colour ", syms[c], " = ", c);
   };
   return syms[c];
end

procedure show(tag, w, x, y, wd, ht)
   local pix, s, i;
   pix := [];
   every put(pix, Pixel(w, x, y, wd, ht));
   write(tag, ": ", *pix, " pixels from ", x, ",", y, " size ", wd, "x", ht);
   s := "";
   every i := 1 to *pix do {
      s ||:= sym(pix[i]);
      if i % wd = 0 then {
         write("   ", s);
         s := "";
      };
   };
   if *s > 0 then write("   ", s);
   return;
end

procedure win(name)
   return open("xwin_fn " || name, "g", "size=40,30", "font=fixed", "fg=black", "bg=white", "canvas=hidden") | stop("no window");
end

procedure main()
   local w, w2, w3, e, a, v, r, f, s, t, c, i, k, n, p, pc, L, names;
   w := win("DrawCurve");
   &error := 1;
   if v := DrawCurve(w, 2, 2, 10, 12, 20, 2) then write("DrawCurve", ": ", image(v))
   else if &error = 0 then write("DrawCurve", ": error ", &errornumber)
   else write("DrawCurve", ": failed");
   &error := 0;
   show("DrawCurve", w, 0, 0, 22, 14);
   &error := 1;
   if v := DrawCurve(w, 25, 20, 35, 20, 30, 28, 25, 20) then write("DrawCurve closed", ": ", image(v))
   else if &error = 0 then write("DrawCurve closed", ": error ", &errornumber)
   else write("DrawCurve closed", ": failed");
   &error := 0;
   show("closed", w, 24, 19, 12, 10);
   &error := 1;
   if v := DrawCurve(w, 1, 1) then write("DrawCurve one point", ": ", image(v))
   else if &error = 0 then write("DrawCurve one point", ": error ", &errornumber)
   else write("DrawCurve one point", ": failed");
   &error := 0;
   &error := 1;
   if v := DrawCurve(w, 1, 1, 2) then write("DrawCurve odd", ": ", image(v))
   else if &error = 0 then write("DrawCurve odd", ": error ", &errornumber)
   else write("DrawCurve odd", ": failed");
   &error := 0;
   &error := 1;
   if v := DrawCurve(w, "a", 1, 2, 3) then write("DrawCurve a string", ": ", image(v))
   else if &error = 0 then write("DrawCurve a string", ": error ", &errornumber)
   else write("DrawCurve a string", ": failed");
   &error := 0;
end
