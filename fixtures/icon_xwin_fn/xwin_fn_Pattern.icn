# xwin_fn_Pattern
# The function ladder of the Icon window facility (skill icon reference.md section 9; the cto 09:2x CST 2026-11-16, officer_07): one small witness a window function, this one Pattern alone, its defaults, its argument checks with the oracle's error numbers (each trapped by &error in main, never inside a co-expression), and a drawing read back with Pixel as letters. Its whole answer is its standard output; its window is a hidden canvas, so its screen line reads none.
global syms, nsyms

procedure sym(c)
   /syms := table();
   /nsyms := 0;
   if /syms[c] then {
      nsyms +:= 1;
      syms[c] := char(96 + nsyms);
      write("colour ", syms[c], " = ", c);
   };
   return syms[c];
end

procedure show(tag, w, x, y, wd, ht)
   local pix, s, i;
   pix := [];
   every put(pix, Pixel(w, x, y, wd, ht));
   write(tag, ": ", *pix, " pixels from ", x, ",", y, " size ", wd, "x", ht);
   s := "";
   every i := 1 to *pix do {
      s ||:= sym(pix[i]);
      if i % wd = 0 then {
         write("   ", s);
         s := "";
      };
   };
   if *s > 0 then write("   ", s);
   return;
end

procedure win(name)
   return open("xwin_fn " || name, "g", "size=40,30", "font=fixed", "fg=black", "bg=white", "canvas=hidden") | stop("no window");
end

procedure main()
   local w, w2, w3, e, a, v, r, f, s, t, c, i, k, n, p, pc, L, names;
   w := win("Pattern");
   &error := 1;
   if v := Pattern(w, "4,#5A5A") then write("Pattern", ": ", image(v))
   else if &error = 0 then write("Pattern", ": error ", &errornumber)
   else write("Pattern", ": failed");
   &error := 0;
   &error := 1;
   if v := WAttrib(w, "pattern") then write("pattern attribute", ": ", image(v))
   else if &error = 0 then write("pattern attribute", ": error ", &errornumber)
   else write("pattern attribute", ": failed");
   &error := 0;
   WAttrib(w, "fillstyle=textured");
   FillRectangle(w, 0, 0, 8, 4);
   show("textured", w, 0, 0, 8, 4);
   &error := 1;
   if v := Pattern(w, "grid") then write("Pattern grid", ": ", image(v))
   else if &error = 0 then write("Pattern grid", ": error ", &errornumber)
   else write("Pattern grid", ": failed");
   &error := 0;
   &error := 1;
   if v := WAttrib(w, "pattern") then write("pattern after", ": ", image(v))
   else if &error = 0 then write("pattern after", ": error ", &errornumber)
   else write("pattern after", ": failed");
   &error := 0;
   &error := 1;
   if v := Pattern(w, "nosuchpattern") then write("Pattern bad", ": ", image(v))
   else if &error = 0 then write("Pattern bad", ": error ", &errornumber)
   else write("Pattern bad", ": failed");
   &error := 0;
   &error := 1;
   if v := Pattern(w, "4,#5Z") then write("Pattern bad spec", ": ", image(v))
   else if &error = 0 then write("Pattern bad spec", ": error ", &errornumber)
   else write("Pattern bad spec", ": failed");
   &error := 0;
   &error := 1;
   if v := Pattern(w) then write("Pattern none", ": ", image(v))
   else if &error = 0 then write("Pattern none", ": error ", &errornumber)
   else write("Pattern none", ": failed");
   &error := 0;
end
