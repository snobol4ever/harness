+    # The IPC sync-step monitor (SCRIP MONITOR-BINARY-DESIGN.md, THE ORACLES ARE INSTRUMENTED IN THEIR OWN SOURCE): the
+    # user's compilation unit is compiled with a fire-point before every statement of every statement list, at every
+    # user routine's entry, after every store to a named variable and around every routine body so each return reports its value. CORE and
+    # any precompilation (--output) are never instrumented, so library code is never an event; RAKUDO_MON=0 turns the
+    # injection off for a control compile. The fire-points are silent unless the MONITOR_READY_PIPE/GO pipes are set.
+    sub mon_active() {
+        return 0 if $*COMPILING_CORE_SETTING;
+        my $o := %*COMPILING<%?OPTIONS>;
+        return 0 if nqp::ishash($o) && (nqp::existskey($o, 'output') || nqp::existskey($o, 'o'));
+        my $e := nqp::atkey(nqp::getenvhash(), 'RAKUDO_MON');
+        nqp::isnull($e) || $e ne '0'
+    }
+    sub mon_stmt($/) {
+        my $op := QAST::Op.new( :op('p6monstmt'), QAST::IVal.new( :value(HLL::Compiler.lineof($/.orig, $/.from, :cache(1))) ) );
+        $op.sunk(1);
+        $op
+    }
+    sub mon_wrap_stmt($/, $ast) {
+        QAST::Stmt.new( :node($/), :returns($ast.returns), mon_stmt($/), $ast )
+    }
+    sub mon_call($name) {
+        my $op := QAST::Op.new( :op('p6moncall'), QAST::SVal.new( :value($name) ) );
+        $op.sunk(1);
+        $op
+    }
+    sub mon_ret($name, $body) {
+        my $op := QAST::Op.new( :op('p6monret'), QAST::SVal.new( :value($name) ), $body );
+        $op.wanted(1);
+        $op
+    }
+    sub mon_first_stmt_child($stmt) {
+        $stmt := $stmt[1] if nqp::istype($stmt, QAST::Stmt) && nqp::elems(@($stmt)) > 1
+            && nqp::istype($stmt[0], QAST::Op) && $stmt[0].op eq 'p6monstmt';
+        $stmt[0]
+    }
+    sub mon_var_name($var) {
+        my $n := $var.name;
+        nqp::eqat($n, '$', 0) ?? nqp::substr($n, 1) !! $n
+    }
+    sub mon_is_named_store($var) {
+        nqp::istype($var, QAST::Var) && ($var.scope eq 'lexical' || $var.scope eq 'lexicalref')
+            && nqp::index('$@%', nqp::substr($var.name, 0, 1)) >= 0 && nqp::chars($var.name) > 1
+    }
+    sub mon_value_after($past, $var) {
+        my $read := QAST::Var.new( :name($var.name), :scope('lexical') );
+        $read.returns($var.returns) if $var.scope eq 'lexicalref';
+        my $op := QAST::Op.new( :op('p6monval'), QAST::SVal.new( :value(mon_var_name($var)) ), $read );
+        $op.sunk(1);
+        QAST::Stmts.new( :resultchild(0), $past, $op )
+    }
+    sub mon_is_decl_stmt($stmt) {
+        my $e := $stmt<EXPR>;
+        $e && ($e<routine_declarator> || $e<package_declarator> || $e<type_declarator> || $e<regex_declarator>) ?? 1 !! 0
+    }
