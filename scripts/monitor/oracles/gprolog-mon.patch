+/*-------------------------------------------------------------------------*
+ * MON_MIRROR_NODE                                                         *
+ *                                                                         *
+ * SCRIP monitor: the mirror of an infix-operator compound read by the     *
+ * parser -- '$m'(StartLine, [MirrorLeft, MirrorRight]); an atomic term or *
+ * any other compound mirrors as its start line (an integer). pl2wam asks  *
+ * for the mirror of each clause it reads and stamps every body goal with  *
+ * its own source line. Off unless Pl_Mon_Mirror_On_0 was called.         *
+ *-------------------------------------------------------------------------*/
+static WamWord
+Mon_Mirror_Node(PlLong line, WamWord m1, WamWord m2)
+{
+  WamWord lst2, lst1, res;
+
+  lst2 = Pl_Put_List();
+  Pl_Unify_Value(m2);
+  Pl_Unify_Value(NIL_WORD);
+
+  lst1 = Pl_Put_List();
+  Pl_Unify_Value(m1);
+  Pl_Unify_Value(lst2);
+
+  res = Pl_Put_Structure(atom_mon_m, 2);
+  Pl_Unify_Integer(line);
+  Pl_Unify_Value(lst1);
+
+  return res;
+}
+
+
+
+
+/*-------------------------------------------------------------------------*
+ * PL_MON_MIRROR_ON_0                                                      *
+ *                                                                         *
+ *-------------------------------------------------------------------------*/
+void
+Pl_Mon_Mirror_On_0(void)
+{
+  pl_mon_mirror_on = TRUE;
+}
+
+
+
+
+/*-------------------------------------------------------------------------*
+ * PL_MON_LAST_READ_MIRROR_1                                               *
+ *                                                                         *
+ *-------------------------------------------------------------------------*/
+Bool
+Pl_Mon_Last_Read_Mirror_1(WamWord m_word)
+{
+  if (pl_mon_last_mirror == NOT_A_WAM_WORD)
+    return FALSE;
+
+  return Pl_Unify(m_word, pl_mon_last_mirror);
+}
+
+
 
 
