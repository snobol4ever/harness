@@ -519,3 +521,131 @@
 	pl2wam(LArg).
 
 :- initialization(go).
+
+
+
+
+          % Monitor fire-points (SCRIP IPC sync-step monitor, monitor_gpx.c in EnginePl):
+          % every user predicate compiled to native code gets a call_c to Pl_Mon_Call at its
+          % entry, a call_c to Pl_Mon_Stmt before each body goal (the clause's first source
+          % line) and a call_c to Pl_Mon_Return at the end of each clause. Built-in, aux,
+          % dynamic, multifile and public predicates and directives are never instrumented.
+          % The fire-points are silent no-ops unless MONITOR_READY_PIPE/MONITOR_GO_PIPE are set.
+
+mon_instrument_pred(Pred, N, LSrcCl, LSrcCl1, WamPre) :-
+	mon_user_pred(Pred, N), !,
+	mon_instrument_clauses(LSrcCl, Pred, N, LSrcCl1),
+	WamPre = [call_c('Pl_Mon_Call', [fast_call], [Pred, N])].
+
+mon_instrument_pred(_, _, LSrcCl, LSrcCl, []).
+
+
+
+
+mon_user_pred(Pred, N) :-
+	atom(Pred),
+	Pred \== '$exe_user',
+	Pred \== '$exe_system',
+	\+ '$aux_name'(Pred),
+	\+ test_pred_flag(bpl, Pred, N),
+	\+ test_pred_flag(bfd, Pred, N),
+	\+ test_pred_flag(dyn, Pred, N),
+	\+ test_pred_flag(multi, Pred, N),
+	\+ test_pred_flag(pub, Pred, N).
+
+
+
+
+mon_instrument_clauses([], _, _, []).
+
+mon_instrument_clauses([Where + Cl|LSrcCl], Pred, N, [Where + Cl1|LSrcCl1]) :-
+	mon_clause_line(Where, Line),
+	mon_clause_mirror(Where, Mirror),
+	mon_instrument_clause(Cl, Pred, N, Line, Mirror, Cl1),
+	mon_instrument_clauses(LSrcCl, Pred, N, LSrcCl1).
+
+
+
+
+mon_clause_line(_ + (L1 - _), L1) :-
+	integer(L1), !.
+
+mon_clause_line(_, 0).
+
+
+mon_clause_mirror(_ + (_ - L2X), M) :-
+	nonvar(L2X),
+	L2X = '$ln'(_, M), !.
+
+mon_clause_mirror(_, none).
+
+
+mon_mirror_args('$m'(_, [MA, MB]), MA, MB) :-
+	!.
+
+mon_mirror_args(_, none, none).
+
+
+mon_mirror_line('$m'(L, _), _, L) :-
+	integer(L), !.
+
+mon_mirror_line(L, _, L) :-
+	integer(L), !.
+
+mon_mirror_line(_, Default, Default).
+
+
+
+
+mon_instrument_clause((Head :- Body), Pred, N, Line, Mirror, (Head :- Body2)) :-
+	!,
+	mon_mirror_args(Mirror, _, MB),
+	mon_body(Body, Line, MB, Body1),
+	mon_return_goal(Pred, N, Ret),
+	Body2 = (Body1, Ret).
+
+mon_instrument_clause(Head, Pred, N, _, _, (Head :- Ret)) :-
+	mon_return_goal(Pred, N, Ret).
+
+
+
+
+mon_return_goal(Pred, N, '$call_c'('Pl_Mon_Return'(Pred, N), [fast_call, by_value])).
+
+mon_stmt_goal(Line, '$call_c'('Pl_Mon_Stmt'(Line), [fast_call, by_value])).
+
+
+
+
+mon_body(G, Line, M, (Stmt , G)) :-
+	var(G), !,
+	mon_mirror_line(M, Line, L),
+	mon_stmt_goal(L, Stmt).
+
+mon_body((A , B), Line, M, (A1 , B1)) :-
+	!,
+	mon_mirror_args(M, MA, MB),
+	mon_body(A, Line, MA, A1),
+	mon_body(B, Line, MB, B1).
+
+mon_body((A ; B), Line, M, (A1 ; B1)) :-
+	!,
+	mon_mirror_args(M, MA, MB),
+	mon_body(A, Line, MA, A1),
+	mon_body(B, Line, MB, B1).
+
+mon_body((A -> B), Line, M, (A1 -> B1)) :-
+	!,
+	mon_mirror_args(M, MA, MB),
+	mon_body(A, Line, MA, A1),
+	mon_body(B, Line, MB, B1).
+
+mon_body((A *-> B), Line, M, (A1 *-> B1)) :-
+	!,
+	mon_mirror_args(M, MA, MB),
+	mon_body(A, Line, MA, A1),
+	mon_body(B, Line, MB, B1).
+
+mon_body(G, Line, M, (Stmt , G)) :-
+	mon_mirror_line(M, Line, L),
+	mon_stmt_goal(L, Stmt).
