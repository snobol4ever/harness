procedure main()
   local k, x, y;
   x := table(7);
   every x[3] <- 19;
   every write("k ", key(x));
   every write("v ", !x);
   x := table();
   every k := 0 to 4 do x[k] := k + 10;
   y := copy(x);
   every !x +:= 20;
   every !y +:= 40;
   every k := 0 to 4 do write(k, " ", x[k], " ", y[k]);
   every x[key(x)] := 99;
   every k := key(x) do write("key ", k, " ", x[k]);
end
