        DEFINE('GC()')                          :(W)
GC      T = DUPL('ab',300)
        GC = 'x3x'                              :(RETURN)
W       U = DUPL('a',4) 'x3x'
        U *GC() . OUT4                          :S(OK)F(NO)
OK      OUTPUT = 'OK-' SIZE(OUT4)               :(END)
NO      OUTPUT = 'NO'
END
