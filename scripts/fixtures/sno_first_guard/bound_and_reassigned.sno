        white = SPAN(' ' CHAR(9)) | CHAR(10) | '#' BREAK(CHAR(10))
        White = *white FENCE(*White | '')
        Gray = FENCE(*White | '')
        $' ' = Gray
        'x  y' ? 'x' *$' ' . W 'y'  :F(N1)
        OUTPUT = '1 [' W ']'
N1      'xy' ? 'x' *$' ' . W 'y'  :F(N2)
        OUTPUT = '2 [' W ']'
N2      S = 'x# c' CHAR(10) ' y'
        S ? 'x' *$' ' . W 'y'  :F(N3)
        OUTPUT = '3 [' SIZE(W) ']'
N3      white = 'Q'
        'xQQy' ? 'x' *$' ' . W 'y'  :F(N4)
        OUTPUT = '4 [' W ']'
N4      'x  y' ? 'x' *White . W 'y'  :F(N5)
        OUTPUT = '5 [' W ']'
N5      White = 'Z'
        'xZy' ? 'x' *$' ' . W 'y'  :F(N6)
        OUTPUT = '6 [' W ']'
N6      Gray = 'nope'
        'xZy' ? 'x' *$' ' . W 'y'  :F(N7)
        OUTPUT = '7 [' W ']'
N7      $' ' = 'z'
        'xzy' ? 'x' *$' ' . W 'y'  :F(N8)
        OUTPUT = '8 [' W ']'
N8      'xy' ? 'x' (*Gray | 'y') . W  :F(N9)
        OUTPUT = '9 [' W ']'
N9      OUTPUT = 'done'
END
