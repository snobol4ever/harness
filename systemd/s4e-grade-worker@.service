[Unit]
Description=Fleet grade worker, instance %i (test-cycle step 4a, CTO-522; the grader's slice, restarted always)

[Service]
Slice=s4e-grader.slice
Environment=S4E_HOME=@ROOT@
Environment=S4E_SEAT=grader
WorkingDirectory=@ROOT@
ExecStart=/bin/bash @ROOT@/harness/scripts/s4e_grade_worker.sh %i
Restart=always
RestartSec=5
TimeoutStopSec=600
